# Copiar a `.env` y completar con la ruta real generada por:
#   gcloud auth application-default login
#
# GOOGLE_APPLICATION_CREDENTIALS la lee la librería google-auth directamente
# del sistema operativo (no pasa por dlt), por eso no puede vivir en
# .dlt/secrets.toml. Ver docs/COMMANDS-PIPELINE.md sección 6.
#
# En Windows, si gcloud usa el Python de Microsoft Store, la ruta queda en
# AppData\Local\Packages\PythonSoftwareFoundation...\LocalCache\Roaming\gcloud\
# en vez de la ubicación estándar %APPDATA%\gcloud\ -- revisar el mensaje de
# salida de `gcloud auth application-default login` para la ruta exacta.
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/application_default_credentials.json

# --- docker-compose.yml: Airflow + dbt (ver docs/ARCHITECTURE.md sección
# "Orquestación (Airflow)") ---
#
# AIRFLOW_UID: UID del host que debe ser dueño de los archivos montados
# (logs, etc.) en Linux. En Windows/Mac no importa, dejar el default.
AIRFLOW_UID=50000

# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CAMBIAR_GENERAR_CON_FERNET
# Cualquier string aleatorio largo sirve (firma las cookies de sesión del webserver).
AIRFLOW_WEBSERVER_SECRET_KEY=CAMBIAR_STRING_ALEATORIO

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CAMBIAR_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.com

POSTGRES_USER=airflow
POSTGRES_PASSWORD=CAMBIAR_PASSWORD
POSTGRES_DB=airflow

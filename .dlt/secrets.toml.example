# Copiar a secrets.toml (mismo directorio) y completar con valores reales.
# secrets.toml está en .gitignore -- nunca debe subirse al repo.
#
# No se incluyen private_key/client_email de BigQuery a propósito: la
# autenticación es vía Application Default Credentials (ADC), no clave JSON
# de cuenta de servicio. Ver docs/COMMANDS-PIPELINE.md sección 6.
[destination.bigquery.credentials]
project_id = "TU_PROJECT_ID"

# Sección nombrada por origen (no "sources.sql_database" genérico): permite
# sumar más orígenes/motores sin colisión, p. ej. [sources.mysql_ventas.credentials]
# o [sources.pgsql_inventario.credentials]. Ver docs/COMMANDS-PIPELINE.md sección 10.
[sources.mssql_business_partners.credentials]
drivername = "mssql+pyodbc"
database = "TU_BASE_DE_DATOS"
password = "TU_PASSWORD"
username = "TU_USUARIO"
host = "TU_HOST_O_IP"
port = 1433
query = { driver = "ODBC Driver 17 for SQL Server" }
